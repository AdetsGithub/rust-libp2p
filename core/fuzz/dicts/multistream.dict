# multistream-select wire fragments (hex-escaped for libFuzzer)
# Frames are unsigned-varint length-prefixed; payloads end with '\n'.

# Header / control payloads (frame bodies)
header="\x2F\x6D\x75\x6C\x74\x69\x73\x74\x72\x65\x61\x6D\x2F\x31\x2E\x30\x2E\x30\x0A"
na="\x6E\x61\x0A"
ls="\x6C\x73\x0A"

# Protocol proposals used by the harness
proto_id="\x2F\x69\x70\x66\x73\x2F\x69\x64\x2F\x31\x2E\x30\x2E\x30\x0A"
proto_a="\x2F\x61\x2F\x31\x2E\x30\x2E\x30\x0A"

# Length-prefixed golden frames (uvi len + payload)
frame_header="\x13\x2F\x6D\x75\x6C\x74\x69\x73\x74\x72\x65\x61\x6D\x2F\x31\x2E\x30\x2E\x30\x0A"
frame_proto_id="\x0F\x2F\x69\x70\x66\x73\x2F\x69\x64\x2F\x31\x2E\x30\x2E\x30\x0A"
frame_na="\x03\x6E\x61\x0A"
frame_ls="\x03\x6C\x73\x0A"
frame_proto_a="\x09\x2F\x61\x2F\x31\x2E\x30\x2E\x30\x0A"

# Varint / framing edges
len_0="\x00"
len_1="\x01"
cont_80="\x80"
max_len_prefix="\xFF\x7F"
overlong_len="\x80\x80"

# Newline terminators
nl="\x0A"
double_nl="\x0A\x0A"
